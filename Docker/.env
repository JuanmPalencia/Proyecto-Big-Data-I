# =============================================================================
# GTP Docker — Variables de entorno
# =============================================================================

# ── MariaDB serving layer (mismas credenciales que Lorca) ────────────────────
PG_HOST=mariadb
PG_PORT=3306
PG_DB=your_database_name
PG_USER=your_database_user
PG_PASSWORD=replace-with-real-password

# ── Spark (local mode en Docker, yarn en Lorca) ──────────────────────────────
SPARK_MASTER=local[4]

# ── Copernicus Land Service — HRL_extract.py ─────────────────────────────────
COPERNICUS_USER=replace-with-copernicus-user
COPERNICUS_PASSWORD=replace-with-copernicus-password

# ── WEkEO API ─────────────────────────────────────────────────────────────────
WEKEO_USERNAME=replace-with-wekeo-user
WEKEO_PASSWORD=replace-with-wekeo-password
WEKEO_TOKEN=replace-with-wekeo-token

# ── InvestEU ETL ──────────────────────────────────────────────────────────────
INVESTEU_BASE_SLEEP=300
INVESTEU_429_PENALTIES=300,600,1200
INVESTEU_TIMEOUT=90
INVESTEU_MAX_RETRIES=3

# ── Rutas dentro del contenedor ───────────────────────────────────────────────
DATA_DIR=/app/data
LOGS_DIR=/app/logs
